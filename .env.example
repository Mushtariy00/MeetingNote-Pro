# Copy to .env and fill in. .env is git-ignored.
# Gemini key from https://aistudio.google.com/apikey
STT_API_KEY=
STT_MODEL=gemini-3.1-flash-lite
# Long random string, e.g. python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
CORS_ORIGINS=http://127.0.0.1:8799,http://localhost:8799
# Empty locally (SQLite). Set by Vercel Storage (Neon) when deployed.
DATABASE_URL=
